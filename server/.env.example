PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=store_master
# Load a small demo dataset when the database is empty. Defaults to false.
SEED_DEMO=false
# Set to true (or pass --reset) once to wipe and recreate all tables. Defaults to false.
RESET_DB=false
# CUPS queue name of the 58mm Bluetooth thermal printer on this laptop. When a
# phone taps Print, the server renders the receipt and queues it on this printer.
PRINTER_NAME=Netum58
# Optional Chrome/Chromium binary used to turn the receipt HTML into a PDF.
# CHROME_BIN=/usr/bin/google-chrome-stable