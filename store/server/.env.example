# Public storefront server (separate port from the shop app on 3001).
PORT=3002

# The storefront reads and writes the same PostgreSQL database as the shop app.
INVENTORY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/store_master
# Or, when DATABASE_URL is not set, these individual values are used:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# INVENTORY_DB_NAME=store_master

# Product/bill images are served by this server from the shop app's folder.
# Default: <repo>/server/uploads
# INVENTORY_UPLOADS_DIR=/path/to/repo/server/uploads
